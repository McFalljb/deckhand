<h1>Safety</h1>
<p><a href="javascript:alert(1)">js</a>
<a href="JAVASCRIPT:alert(1)">js upper</a>
<a href="JaVaScRiPt:alert(1)">js mixed</a>
<a href="javascript:alert(1)">js entity</a>
<a href="javascript:alert(1)">js named entity</a>
<a href="javascript:alert(1)">js escaped</a>
<a href="javascript:alert(1)">js angle</a>
<a href="javascript:alert(1)">js spaces</a>
[js tab](java	script:alert(1))
<a href="vbscript:msgbox(1)">vbscript</a>
<a href="data:text/html;base64,PHNjcmlwdD5hbGVydCgxKTwvc2NyaXB0Pg==">data</a>
<a href="DATA:text/html,%3Cscript%3Ealert(1)%3C/script%3E">data upper</a>
<a href="file:///etc/passwd">file</a>
<a href="deckhand://do-something">app scheme</a>
<a href="%6Aavascript:alert(1)">percent scheme</a>
[newline in dest](java
script:alert(1))
<a href="javascript:alert(&#x27;ref&#x27;)">ref js</a>
<a href="javascript:alert(1)">javascript:alert(1)</a>
<a href="data:text/html,x">data:text/html,x</a>
<a href="file:///etc/passwd">file:///etc/passwd</a>
javascript:alert(1) as bare text
<a href="http://www.example.com/javascript:alert(1)">www.example.com/javascript:alert(1)</a></p>
<p><img src="javascript:alert(1)" alt="img js" />
<img src="data:image/png;base64,iVBORw0KGgo=" alt="img data" />
<img src="https://tracker.example.com/pixel.gif" alt="img remote" />
<img src="file:///etc/passwd" alt="img file" /></p>
<p><a href="javascript:alert(1)">raw link</a>
<img src=x onerror=alert(1)></p>
<iframe src="https://example.com"></iframe>
<script>alert(1)</script>
<style>body{display:none}</style>
<textarea>raw</textarea>
<div onclick="alert(1)">
<p><em>markdown inside an html block after a blank line</em></p>
</div>
<title>tag filter</title> <xmp>x</xmp> <noembed>y</noembed>
<p><a href="mailto:a@example.invalid?subject=hi">mail</a>
<a href="https://example.com/ok">https</a>
<a href="http://example.com/ok">http</a>
<a href="other.md">relative</a>
<a href="/etc/hosts">absolute</a>
<a href="../../outside.md">dotdot</a>
<a href="#safety">anchor</a>
<a href="other.md?x=1#frag">query</a></p>
---- blocks
Document line=1
  Heading line=1 level=1 anchor="safety"
  Paragraph line=3
  Paragraph line=29
  Paragraph line=34
  Html_Block line=36
  Html_Block line=41
  Paragraph line=43
  Html_Block line=45
  Html_Block line=47
  Paragraph line=49
