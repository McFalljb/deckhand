@(test)
image_tab_loads :: proc(t: ^testing.T) {
	context.allocator = runtime.heap_allocator()
	dir := fmt.aprintf("build/test-data/image-tab-%d", os.get_pid())
	os.remove_all(dir)
	os.make_directory_all(dir)
	defer os.remove_all(dir)
	put :: proc(dir, name, data: string) -> string {
		p := fmt.tprintf("%s/%s", dir, name)
		_ = os.write_entire_file(p, transmute([]u8)data)
		return p
	}
	ids := [?]u64{900001, 900002, 900003, 900004, 900005, 900006, 900007}
	defer for id in ids do editor_drop(id)
	// opened: an image tab, nothing decoded until it is drawn (image_ensure)
	open :: proc(id: u64, path: string) -> ^Editor {
		e := editor_new(id, path)
		image_ensure(e)
		return e
	}

	e := editor_new(ids[0], put(dir, "a.png", TINY_PNG))
	testing.expect(t, e.image_tab && e.img == nil && e.img_stale && e.readonly, "not decoded before its first draw")
	image_ensure(e)
	testing.expect(t, e.img != nil && !e.img_stale, "a picture")
	if e.img != nil {
		testing.expect(t, e.img.w == 2 && e.img.h == 1 && e.img.tw == 2 && len(e.img.pixels) == 8, "2 x 1 RGBA")
		testing.expect_value(t, e.img.pixels[4 + 3], u8(128)) // the second pixel's alpha
	}
	testing.expect_value(t, tb_len(&e.buf), 0) // no text: nothing for an agent to read
	testing.expect(t, strings.contains(e.refused, "PNG image, 2 × 1 px"), e.refused)

	wide := open(ids[5], put(dir, "wide.png", WIDE_PNG))
	testing.expect(t, wide.img != nil && wide.img.w == 8193 && wide.img.tw == 4096 && wide.img.th == 1, "8193 x 1: 4096 x 1")
	if wide.img != nil do testing.expect_value(t, wide.img.pixels[3 * 4], u8(6)) // the fourth kept pixel is pixel 6
	tall := open(ids[6], put(dir, "tall.png", TALL_PNG))
	testing.expect(t, tall.img != nil && tall.img.h == 10000 && tall.img.tw == 1 && tall.img.th == 5000 && len(tall.img.pixels) == 5000 * 4, "1 x 10000: 1 x 5000")
	if tall.img != nil do testing.expect_value(t, tall.img.pixels[3 * 4], u8(6))
	huge := open(ids[1], put(dir, "huge.png", HUGE_PNG))
	testing.expect(t, huge.image_tab && huge.img == nil && strings.contains(huge.refused, "megapixels"), huge.refused)
	webp := open(ids[2], put(dir, "a.webp", "RIFF\x10\x00\x00\x00WEBPVP8 \x00\x00\x00\x00"))
	testing.expect(t, webp.img == nil && strings.contains(webp.refused, "WebP"), webp.refused)
	bad := open(ids[3], put(dir, "bad.png", "\x89PNG\r\n\x1a\nnot really"))
	testing.expect(t, bad.img == nil && strings.has_prefix(bad.refused, "Can't display this image"), bad.refused)
	text := editor_new(ids[4], put(dir, "notes.png", "just text\n"))
	testing.expect(t, !text.image_tab && text.refused == "" && tb_len(&text.buf) == 10, "a .png that is text: a text tab")

	// changed on disk: the picture goes and nothing is decoded until the next draw
	put(dir, "a.png", "\x89PNG\r\n\x1a\nbroken now, and longer")
	editor_check_disk(e)
	testing.expect(t, e.image_tab && e.img == nil && e.img_stale, "stale, not decoded")
	image_ensure(e)
	testing.expect(t, e.img == nil && strings.has_prefix(e.refused, "Can't display"), e.refused)
	put(dir, "a.png", TINY_PNG)
	editor_check_disk(e)
	image_ensure(e)
	testing.expect(t, e.img != nil && e.readonly, "back")
	// now text: a text tab at its next draw
	put(dir, "a.png", "plain text now\n")
	editor_check_disk(e)
	image_ensure(e)
	testing.expect(t, !e.image_tab && e.img == nil && e.refused == "" && tb_len(&e.buf) == 15, "became text")
	testing.expect_value(t, image_size_text(512), "512 B")
	testing.expect_value(t, image_size_text(3 * 1024 + 400), "3.4 KB")
}
