package core

// Every command Deckhand knows, in one table: its wire name, arguments, what
// it does, who may send it, its confirmation class and whether it is
// long-running. caller_may (commands.odin) checks callers against `who`, and
// `list_commands` answers from it, so a new command is listed for the
// callers that may send it as soon as it has a row (a test checks that every
// command type has one).

Command_Who :: enum {
	Anyone, // the user, scripts, control callers (the Home agent) and Deckhand itself; not pi tabs
	Query, // anyone, pi tabs too
	User, // the user (ui) and Deckhand itself: settings that bound what agents may do
	Report, // a pi tab's bridge for its own tab, scripts (tests), the user, Deckhand; not control
	Bridge, // only the tab's own bridge (panel)
	Internal, // Deckhand itself; never parsed from JSON
	Own_Session, // anyone but apps; a pi or Claude tab only for its own session (the command checks: browser_*, app_*)
	User_Control, // the user, control callers (the Home agent) and Deckhand itself: opens a Finder window
	Claude, // a Claude tab's plugin for its own tab (caller panel + claude), scripts (tests), Deckhand; never a pi tab's bridge
}

Command_Spec :: struct {
	type:         string, // as on the wire (command_type)
	args:         string, // "tab_id, confirm?": `?` = optional
	does:         string,
	who:          Command_Who,
	confirm:      Maybe(Command_Class), // may ask for confirmation
	long_running: bool, // returns `pending`, then a `finished` event
}

COMMAND_SPECS := [?]Command_Spec {
	{type = "get_state", does = "the state snapshot", who = .Query},
	{type = "list_commands", does = "the commands this caller may send", who = .Query},
	{type = "add_project", args = "cwd", does = "add (or find) a project and select it; created_id = project id", who = .Anyone},
	{type = "select_project", args = "project_id", does = "select a project and list its sessions", who = .Anyone},
	{type = "rename_project", args = "project_id, name", does = `rename a project ("" = path label)`, who = .Anyone},
	{type = "open_session", args = "project_id, pi_session_id", does = "resume a pi session, or a Claude Code session of the project (Deckhand's history, or a transcript found in an account's projects/ folder: a Claude-only session under its account, no flags) (focuses it if open); created_id = open session id", who = .Anyone},
	{type = "new_chat", args = "project_id", does = "start a new pi session; created_id = open session id", who = .Anyone},
	{type = "focus_session", args = "session", does = "show an open session", who = .Anyone},
	{type = "close_session", args = "session, confirm?, comments?", does = "stop an open session's tabs and remove it from the open sessions and the saved workspace (its pi session file stays); with pending comments, comments: \"drop\" (control callers must say)", who = .Anyone, confirm = .Tab_Close},
	{type = "new_shell_tab", args = "session, cwd?, pane?", does = "open a shell tab in an open session (pane: in that pane of it, else the focused one); created_id = tab id", who = .Anyone},
	{type = "close_tab", args = "tab_id, confirm?, comments?", does = "close a tab (a pi tab cannot be closed); with pending comments made on it, comments: \"send\" (Send now first) or \"drop\" (control callers must say)", who = .Anyone, confirm = .Tab_Close},
	{type = "focus_tab", args = "tab_id", does = "focus a tab (and its pane) and make its session current", who = .Anyone},
	{type = "split_pane", args = "pane?, direction, tab_id?, focus?", does = "split a pane (default: the current session's focused one) right, down, left or up; tab_id: move that tab of the session into the new pane (not a pane's only tab), else a new shell tab opens there; focus false: the keyboard stays; created_id = the new pane", who = .Anyone},
	{type = "close_pane", args = "pane", does = "unsplit a pane: its tabs join the neighbouring pane (nothing stops)", who = .Anyone},
	{type = "focus_pane", args = "pane? | direction", does = "focus a pane (its tab gets the keyboard; its session current), or the current session's pane left, right, up, down, next or prev of the focused one", who = .Anyone},
	{type = "move_tab", args = "tab_id, pane, index?", does = "move a tab into another pane of its session at strip position index (default the end), or reorder it within its pane; a pane it leaves empty closes", who = .Anyone},
	{type = "set_split", args = "split, ratio", does = "a divider's position: the split's first child's share (clamped by the panes' minimum sizes)", who = .Anyone},
	{type = "equalize_panes", args = "session?", does = "even every divider of a session (default the current one) by the panes on each side", who = .Anyone},
	{type = "copy_selection", args = "tab_id", does = "copy a tab's terminal selection", who = .Anyone},
	{type = "terminal_link", args = "tab_id, url, external?", does = "open a link from a terminal tab as a ⌘-click does (the user's only): http and https in a browser tab of the terminal's session, in front (external, Home's terminal or no browser: the default browser); mailto in the mail app; other schemes are refused", who = .User},
	{type = "send_text", args = "tab_id, text", does = "paste text into a shell tab (control callers: not into pi tabs, use pi_prompt; not while that session's pi waits for the user)", who = .Anyone},
	{type = "set_focus", args = "widget", does = `focus a widget ("" = terminal; rename_project, sidebar_filter, agent_input; palette, settings and shortcuts for the user only); control callers not while the agent's terminal has it`, who = .Anyone},
	{type = "focus_take", args = "widget", does = "Deckhand moves the keyboard to a widget itself (a sheet it opened, a new tab's URL field, an install's setup sheet)", who = .Internal},
	{type = "focus_release", args = "widget", does = "a widget that closed lets go of the keyboard (back to the terminal) when it has it", who = .Internal},
	{type = "set_last_harness", args = "harness", does = "the harness the New session picker lists first", who = .Internal},
	{type = "set_layout", args = "left_width?, right_width?, left_open?, right_open?, drawer_width?, drawer_pinned?", does = "column widths (left 200-480 px, right 240-560 px; a small window draws them narrower), whether each column shows, the agent drawer's width (at least 320 px; at most 70% of the space right of the left column, pinned also leaving the centre its minimum, and never over 1600 px) and pin", who = .Anyone},
	{type = "set_panel", args = "panel, open", does = "open or close a panel in the right column", who = .Anyone},
	{type = "set_panel_collapsed", args = "panel, collapsed", does = "fold a panel's section", who = .Anyone},
	{type = "set_home", args = "open", does = "show the agent's drawer, its pi terminal (starts the agent's pi on first open); hiding it is the user's, and the agent cannot send it", who = .Anyone},
	{type = "set_agent_name", args = "name", does = `the agent's name ("" = Atlas); the user's, as it labels the agent's questions and notifications`, who = .User},
	{type = "set_agent_model", args = "model", does = `the agent's model, "provider/id" or "provider/id:thinking" ("" = pi's default); the user's; passed as --model when the agent starts a new session or after it changed`, who = .User},
	{type = "agent_model_picker", does = "show the agent's drawer and open pi's model selector in its terminal (Ctrl+L); the user's", who = .User},
	{type = "set_notify", args = "on", does = "OS notifications from the agent while Deckhand is in the background", who = .User},
	{type = "copy_control_token", does = "Settings › Copy a control token: a new control token for `deckhand --ctl`, as shell exports, onto the clipboard (never in the result or a log); the user's", who = .User},
	{type = "set_separate_core", args = "on", does = "experimental: run sessions in a background core (deckhand-core serve) from the next launch", who = .User},
	{type = "set_keep_sessions", args = "on", does = "keep sessions running when Deckhand quits or updates (on by default; the session holder keeps their processes; reopening Deckhand adopts them)", who = .User},
	{type = "set_tidy_projects", args = "on", does = "tidy the Projects list (default on): temp and missing folders hidden (show_hidden shows them, with the reason), subfolders folded into their project", who = .User},
	{type = "set_pinned", args = "cwd? | project_id? | pi_session_id?, pinned, index?", does = "pin or unpin a project or a session (a project's or a chat) at the top of its section; index places it among the pinned; unpinning works for ones that are gone (cwd, pi_session_id)", who = .Anyone},
	{type = "set_hidden", args = "cwd? | project_id? | pi_session_id?, hidden", does = "hide a project or session from the left column (shown again with show_hidden; nothing is deleted; waiting work always shows)", who = .Anyone},
	{type = "set_sort", args = "section, by", does = "sort a left-column section (projects, sessions, chats) by recent, name, created or attention (needs you, then finished and not seen, then working, then the rest)", who = .Anyone},
	{type = "set_unread", args = "tab_id? | pi_session_id?, unread", does = "mark a terminal tab, or an open session (its active tab), as finished and not seen (unread: true) or seen (false: all its tabs); looking at a tab marks it seen", who = .Anyone},
	{type = "set_sidebar_folded", args = "section, folded", does = "fold a left-column section (open, projects, chats)", who = .Anyone},
	{type = "set_row_expanded", args = "path, expanded", does = "open or collapse a parent or group row of the Projects tree (its folder path; collapsed by default; saved)", who = .Anyone},
	{type = "set_filter", args = "text?, running?, waiting?, pinned?, show_hidden?", does = "filter the left column: fuzzy text over names, paths and titles; quick filters; show hidden items", who = .Anyone},
	{type = "reveal", args = "project_id, pi_session_id?", does = "show a project's folder (or one of its session files) in the file manager (the user and control only)", who = .User_Control},
	{type = "session_info", args = "project_id, pi_session_id, to?", does = `a session's info from its header and file only (id, file, project, folder, title, created, modified, model; never its messages): data.text (a fenced block) and the fields. to: "clipboard" also copies it; "agent" (the user only) puts it into the agent's input, not sent`, who = .Anyone},
	{type = "copy_path", args = "project_id, pi_session_id?", does = "copy a project's folder (or one of its session files) path", who = .Anyone},
	{type = "cancel_confirmation", args = "token", does = "drop a pending confirmation", who = .Anyone},
	{type = "rescan", does = "rescan projects and sessions", who = .Anyone, long_running = true},
	{type = "refresh_shell_env", does = "ask the login shell for its environment again (Deckhand started from the Dock or Finder) and merge it in for new tabs; open tabs keep theirs; refused when started from a terminal; the user's", who = .User, long_running = true},
	{type = "quit", args = "confirm?, stop_sessions?", does = "quit Deckhand (stop_sessions: the session holder's sessions too; keep_sessions)", who = .Anyone, confirm = .App_Quit},
	{type = "pi_prompt", args = "tab_id, text, images?", does = "send a prompt to a pi tab as a user message, with images [{mime, data (base64)}] if given (at most 8, 2 MB; refused while it waits for the user)", who = .Anyone, long_running = true},
	{type = "pi_wait_idle", args = "tab_id, timeout_ms?", does = "wait until a pi tab is idle", who = .Anyone, long_running = true},
	{type = "pi_restart", args = "tab_id, pick_model?", does = "start pi again in a pi tab whose process exited, on the same session (the dead tab's Restart); pick_model: pi's model selector opens once it is up (Restart with model…)", who = .Anyone},
	{type = "pi_reload", args = "tab_id, confirm?", does = "reload a pi tab once it is idle", who = .Anyone, confirm = .Session_Restart, long_running = true},
	{type = "set_terminal_text_size", args = "pt", does = "the terminals' and the editor's text size in points, 9-28 (0 = the look's, 14)", who = .Anyone},
	{type = "pi_reload_all", args = "only_changed?, confirm?", does = "reload every running pi tab (only_changed: those a watched pi settings, extension, skill, prompt, theme or context file changed for): idle ones now, busy or blocked ones (background shells or workers) once idle; the user's click asks only when background work would wait; Atlas's call is always confirmed by the user; data: reloading, queued, no_bridge tab ids", who = .Anyone, confirm = .Session_Restart},
	{type = "pi_restart_updated", args = "confirm?", does = "restart the pi tabs that started with an older pi than the one on disk, or with other optional pi extensions than set_pi_extension chose (pi --session, same session): idle ones now, busy or blocked ones once idle; data: restarting, queued, no_bridge tab ids; the user's", who = .User, confirm = .Session_Restart},
	{type = "claude_restart_changed", args = "update?, all?, confirm?", does = "restart the running Claude tabs that a changed Claude Code file needs restarting for (update: those on an older claude than the one on disk; all: every running Claude tab, changed or not), each with --resume <its conversation>: idle ones (turn idle per hooks and OSC 7501, nothing typed or held, no subagent running) now, busy ones once idle; a tab without a Claude session id is left alone; always confirmed (background work Claude started stops); the user's saved flags only for the user's; data: restarting, queued, no_session tab ids", who = .Anyone, confirm = .Session_Restart},
	{type = "claude_reload_later", args = "update?", does = "hide the Claude Code settings bar (update: the Claude Code update bar) until the next change (version) and drop the restarts still waiting for idle; the user's", who = .User},
	{type = "pi_reload_later", args = "restart?", does = "hide the hot-reload bar (restart: the pi-update bar) until the next change and drop the reloads (restarts) still waiting for idle; the user's", who = .User},
	{type = "set_theme", args = "name", does = "the look: graphite, warm or ghostty", who = .Anyone},
	{type = "set_appearance", args = "mode", does = "light or dark: system (follows the OS), light or dark; independent of the look", who = .Anyone},
	{type = "set_reduce_motion", args = "on", does = "no fades, slides or pulsing dots", who = .Anyone},
	{type = "set_text_size", args = "size", does = "the chrome's text: small, medium, default or large (terminals keep theirs)", who = .Anyone},
	{type = "set_home_dir", args = "path, create?", does = `the main folder (sessions/, jobs/, memory/, atlas/, chats/; missing ones made, empty; "" = unset); create: make it first. set_notes_dir is the old name`, who = .User},
	{type = "set_folder", args = "kind, path", does = `a subfolder's override (kind: sessions|jobs|memory|atlas|chats; "" = <main>/<kind>); chats: where new chats run, the old folder becomes an ordinary project. set_chats_dir is the old name for chats`, who = .User},
	{type = "setup_sheet", args = "open", does = "the first-run sheet: open, or close (done or skipped: it does not open by itself again)", who = .User},
	{type = "set_chats_readonly", args = "on", does = "start chats read-only (pi: its read tools only, plus PI_KIT_READONLY=1; Claude: Deckhand's read-only profile) or full", who = .User},
	{type = "set_pi_extension", args = "name, on", does = "turn one of the pi integration's optional extensions (guardrails, shell, notes; get_state settings.pi_extensions) on or off for the pi tabs started from now on; running tabs keep theirs until restarted (the restart bar offers it); the user's", who = .User},
	{type = "set_claude_default_flags", args = "skip_permissions, confirm?", does = "default Claude Code flags for each start of a Claude tab the user makes (new tab, session, chat, the user's resume, restore and restart; never an agent's, a panel's or an app's; a read-only chat leaves it out): skip_permissions adds --dangerously-skip-permissions (off by default; turning it on is confirmed), never saved into a tab's flags", who = .User},
	{type = "set_confirm_policy", args = "caller, class, mode", does = "how a caller's destructive commands of a class are confirmed (ask, trusted, auto)", who = .User},
	{type = "set_close_confirm", args = "tab_kind, rule", does = "when closing a running tab asks (auto, always, never)", who = .User},
	{type = "pi.session", args = "tab_id?, pi_session_id, session_file?, cwd?", does = "a pi tab reports its session", who = .Report},
	{type = "pi.status", args = "tab_id?, agent, waiting, question?, blockers?", does = "a pi tab reports its status", who = .Report},
	{type = "panel.set", args = "panel, title?, rows", does = "a pi tab publishes one of its panels", who = .Bridge},
	{type = "panel.remove", args = "panel", does = "a pi tab removes one of its panels", who = .Bridge},
	{type = "pi.attached", args = "attachment_id", does = "a pi tab's bridge: the user's message took that attachment of pending comments (pi.attach); they are cleared", who = .Bridge},
	{type = "system_appearance", args = "light", does = "the OS switched between light and dark", who = .Internal},
	{type = "open_file", args = "path, line?, col?, session?, preview?", does = "open a file in an editor tab of a session (default: the current one; a relative path is from its folder), or focus the tab that has it; line/col are 1-based; preview: a preview tab that replaces the session's clean preview tab; created_id = tab id; data.refused when it cannot be shown (binary, over 20 MB)", who = .Anyone},
	{type = "keep_tab", args = "tab_id", does = "make a preview editor tab an ordinary one (editing does this too)", who = .Anyone},
	{type = "editor_state", args = "tab_id", does = "an editor tab: path, dirty, cursor and selection (1-based line/col), language, line ending, indentation, disk (same/changed/missing), git line counts", who = .Anyone},
	{type = "save_file", args = "tab_id", does = "save an editor tab to its file (atomic; refused while the file changed on disk until reload_file or keep_buffer)", who = .Anyone},
	{type = "goto", args = "tab_id, line, col?", does = "move an editor tab's cursor to a 1-based line and column and show it", who = .Anyone},
	{type = "reload_file", args = "tab_id, confirm?", does = "replace an editor tab's text with the file on disk (one undo step); asks while it has unsaved changes", who = .Anyone, confirm = .Tab_Close},
	{type = "keep_buffer", args = "tab_id", does = "after the file changed on disk: keep the editor's text (saving then overwrites the file)", who = .Anyone},
	{type = "diff_file", args = "tab_id, against", does = "open a read-only diff of an editor tab against git HEAD (against: head) or the file on disk (disk); created_id = the diff tab", who = .Anyone},
	{type = "set_wrap", args = "tab_id, on", does = "soft-wrap long lines in an editor tab", who = .Anyone},
	{type = "list_dir", args = "path, ignored?", does = "a folder inside a project: entries (name, kind file/dir/symlink, git status code), folders first, natural order; .git and gitignored entries left out (ignored: listed, marked ignored)", who = .Anyone},
	{type = "create_file", args = "path, confirm?", does = "create an empty file inside a project (and its folders); data.path. A control caller outside its own project confirms", who = .Anyone, confirm = .Fs_Write},
	{type = "create_dir", args = "path, confirm?", does = "create a folder inside a project; data.path. A control caller outside its own project confirms", who = .Anyone, confirm = .Fs_Write},
	{type = "rename_path", args = "from, to, confirm?", does = "rename or move a file or folder inside a project; open editor tabs follow it. A control caller outside its own project confirms", who = .Anyone, confirm = .Fs_Write},
	{type = "delete_path", args = "path, confirm?", does = "move a file or folder inside a project to the Trash", who = .Anyone, confirm = .Delete},
	{type = "reveal_in_finder", args = "path", does = "show a file or folder inside a project in Finder", who = .Anyone},
	{type = "set_left_tab", args = "tab", does = "what the left column shows: sessions, files (the file tree of the project on screen) or settings (pi's settings files as a tree)", who = .Anyone},
	{type = "files_expand", args = "path, expanded", does = "expand or collapse a folder in the Files tree (inside a project)", who = .Anyone},
	{type = "files_collapse_all", args = "root", does = "collapse every folder of the Files tree at root (a project or session folder)", who = .Anyone},
	{type = "files_reveal", args = "path", does = "expand the folders above a path in the Files tree and select it", who = .Anyone},
	{type = "list_worktrees", args = "path?", does = "the git checkouts and branches of a project's repository (default: the Files tab's): worktrees (main first: path, branch, detached, locked, prunable, missing, dirty = changed paths, ahead/behind its upstream or the default branch, merged), branches without a worktree (ahead/behind the default branch, merged, last commit date and subject), root = the checkout the Files tree shows; loading while git runs (ask again)", who = .Query},
	{type = "files_set_root", args = "path, base?", does = "the Files tree of a project or session folder (base, default the Files tab's) shows another checkout of its repository (path; \"\" or base = its own folder again); kept per project, dropped when the folder goes", who = .Anyone},
	{type = "worktree_cleanup", args = "path, confirm?", does = "remove a clean worktree whose branch is merged into the default branch (git worktree remove, never forced) and delete that branch (git branch -d); never the main checkout; refused while an ignored file looks like a secret. git checks on a worker: pending, then the confirmation (or the error) in the finished event", who = .User, confirm = .Delete, long_running = true},
	{type = "worktree_cleanup_done", args = "path, err?", does = "a worker checked or removed a worktree", who = .Internal},
	{type = "worktree_session", args = "project_id, path", does = "start a new pi session of a project running in one of its repository's checkouts (kept with the project's sessions); created_id = open session id", who = .Anyone},
	{type = "worktrees_done", args = "common, out", does = "a worker read a repository's worktrees and branches", who = .Internal},
	{type = "set_files_filter", args = "text", does = "filter the Files tree: fuzzy words matched against paths (\"\" = the tree)", who = .Anyone},
	{type = "job_list", args = "unread?", does = "Atlas's jobs: notes_dir, paused, unread, jobs [{id, name, path, project, schedule, enabled, paused, paused_why, running, queued, next_due, last_at, last_status, last_headline, last_run, unread, error, warnings, recent, needs_you}] (unread: only jobs with unread runs); summaries are redacted", who = .Query},
	{type = "job_runs", args = "job, limit?", does = "a job's last runs (default 10), newest first: run, summary_path, meta (status, scheduled_at, started, ended, exit, cost, turns, headline, needs_you, blocked, delivered, read); redacted", who = .Query},
	{type = "job_run_now", args = "job", does = "run a job now (refused while jobs are paused or the job runs; for callers other than the user also while the job is paused or disabled)", who = .Anyone},
	{type = "job_stop", args = "job?", does = "stop a running job (\"\" = every running job): SIGTERM, SIGKILL after 5 s", who = .Anyone},
	{type = "jobs_pause", args = "job?", does = "pause one job, or all jobs (no job: the kill switch; running ones finish)", who = .Anyone},
	{type = "jobs_resume", args = "job?", does = "resume one job (its failure count starts over) or all jobs; the user's", who = .User},
	{type = "job_sheet", args = "open, job?, for_project?", does = "the job sheet (a form that writes a job note): open it for a new job (for_project: preselected owner) or for job (its id) to edit; or close it. The user's", who = .User},
	{type = "job_save", args = "path?, text, based_on?", does = "the job sheet's Create (no path: a new note, enabled: true) or Save (path: that job's note, rewritten; its id stays; based_on: the hash of the text the edit started from, refused when the file changed since). text: the whole note, which must parse. The user's", who = .User},
	{type = "job_create", args = "name?, schedule?, prompt?, folder?, for_project?", does = "write a job note in <notes_dir>/jobs/ (enabled: true); for_project: its owner (a project's folder or name, atlas, chats or none), also its folder unless folder is given; data.path", who = .Anyone},
	{type = "job_mark_read", args = "job?, run?", does = "mark a job's runs (or one run, or every job's) read", who = .Anyone},
	{type = "job_set_enabled", args = "job, on", does = "set enabled: in the job's note; the user's", who = .User},
	{type = "job_delete", args = "job, confirm?", does = "move a job's note to the Trash (asks first, class delete); its run history stays in the data folder", who = .Anyone, confirm = .Delete},
	{type = "job_open", args = "job, what", does = "open a job's note (what: note) or last report (report; marks it read) in an editor tab, or show its last run folder (run_folder)", who = .Anyone},
	{type = "set_pi_path", args = "path", does = "the pi job runs start (absolute; \"\" = pi on the jobs' PATH); the user's", who = .User},
	{type = "set_job_limits", args = "max_cost?, timeout?, max_turns?, day?, week?, month?, concurrency?, loop_calls?, stall?, fail_pause?", does = "job limits (0 = off; USD, seconds): per run, per day/week/month across jobs, runs at once; and the safety stops' thresholds (cannot be turned off); the user's", who = .User},
	{type = "jobs_sync", does = "the Jobs rows follow the scheduler", who = .Internal},
	{type = "jobs_tick", does = "the scheduler's timer: due checks and the watchdog while frames are paused", who = .Internal},
	{type = "job_run_done", args = "run", does = "a job run's pi exited", who = .Internal},
	{type = "jobs_env", args = "path, notes", does = "the login shell's PATH and PI_KIT_NOTES_DIR", who = .Internal},
	{type = "tab_exited", args = "tab_id", does = "a tab's process exited", who = .Internal},
	{type = "program_status", args = "tab_id", does = "a terminal tab's OSC 7501 status changed", who = .Internal},
	{type = "rescan_done", args = "request_id", does = "a rescan finished", who = .Internal},
	{type = "refresh_shell_env_done", args = "request_id, ok", does = "a worker read the login shell's environment", who = .Internal},
	{type = "bridge_done", args = "request_id, ok, error?", does = "a pi tab's bridge answered", who = .Internal},
	{type = "claude_typed", args = "tab_id", does = "a window in another process: the user typed in a Claude tab's prompt", who = .Internal},
	{type = "git_head_done", args = "tab_id, path, in_repo, tracked, head", does = "a worker read an editor file's HEAD version", who = .Internal},
	{type = "git_status_done", args = "root, ok, out", does = "a worker ran git status for a repository", who = .Internal},
	{type = "file_list_done", args = "root, out", does = "a worker refreshed a project's file list", who = .Internal},
	{type = "restore_sidebar", args = "pinned_projects, pinned_sessions, hidden_projects, hidden_sessions", does = "saved pins and hidden items back into the state", who = .Internal},
	{type = "notifications_list", args = "limit?", does = "the bell's entries, newest first (default 20): unread count; per entry id, time (ISO 8601 UTC), kind (finished, waiting, error, exited, job), title, read, and a session's project, session_id, tab_id, pi_session_id or a job's job_id, status (finished, needs_you, failed), summary (not for control callers); titles and ids only", who = .Anyone},
	{type = "notifications_mark_read", args = "id? | session? | all?", does = "mark the bell's entries read: one, an open session's, or all; the user's", who = .User},
	{type = "notifications_clear", does = "remove every entry from the bell; the user's", who = .User},
	{type = "update_check", does = "check GitHub for a newer Deckhand release now (the menu's Check for Updates…); the user's", who = .User},
	{type = "update_skip", does = "do not offer the available Deckhand version again; the user's", who = .User},
	{type = "update_later", does = "hide the update bar until the next offer; the user's", who = .User},
	{type = "update_download", does = "download the available Deckhand release and check it (signature, checksum, bundle, codesign); nothing is installed; the user's", who = .User},
	{type = "update_install", args = "confirm?", does = "install the checked update and restart Deckhand (asks while sessions, shells or jobs run); the user's, never an agent's", who = .User, confirm = .App_Quit},
	{type = "set_update_check", args = "on", does = "check for Deckhand updates about once a day (default on); the user's", who = .User},
	{type = "update_env", args = "version, bundle, why_not", does = "the running Deckhand's version and bundle", who = .Internal},
	{type = "update_tick", does = "the update timer: a check when one is due", who = .Internal},
	{type = "update_checked", args = "body, err", does = "a worker fetched the latest release", who = .Internal},
	{type = "update_prepared", args = "staged, err", does = "a worker downloaded and checked an update", who = .Internal},
	{type = "set_notifications", args = "finished?, waiting?, errors?, jobs?, os?", does = "what the bell collects (finished runs, waiting for you, errors and exits, jobs) and whether waiting, errors, exits and jobs that need you or failed also raise an OS notification while Deckhand is in the background; the user's", who = .User},
	{type = "notify_post", args = "job: job_id, title, status, summary, run_dir", does = "a job's result for the bell (job.finished)", who = .Internal},
	{type = "changes_open", args = "session?, path?", does = "open (or focus) the Changes tab of a checkout in an open session (default: the current one): path's checkout, default the session's folder's; it lists the uncommitted files (staged, unstaged, untracked) and the files changed by commits on the branch that are not on the default branch, with their diffs; created_id = tab id", who = .Anyone},
	{type = "changes_list", args = "tab_id? | path?", does = "a checkout's changed files (a Changes tab's, a folder's, default the current session's): root, branch, default_branch, ahead (commits not on the default branch), loading while git runs (ask again), files: path, old_path, status (M, A, D, R, U, untracked), scope (uncommitted, committed), staged (none, partly, all), added/removed lines, binary, credential. Paths and counts only, never diff text", who = .Anyone},
	{type = "changes_stage", args = "tab_id, path", does = "stage a listed uncommitted file of a Changes tab (git add); the user's", who = .User, long_running = true},
	{type = "changes_unstage", args = "tab_id, path", does = "unstage a listed file of a Changes tab (git restore --staged); the user's", who = .User, long_running = true},
	{type = "changes_discard", args = "tab_id, path, confirm?, second?", does = "discard a listed file's uncommitted changes (back to HEAD); a file git does not have goes to the Trash after a second confirmation; the user's, confirmed", who = .User, confirm = .Delete, long_running = true},
	{type = "changes_commit", args = "tab_id, message", does = "commit what is staged in a Changes tab's checkout with the user's git hooks; the user's", who = .User, long_running = true},
	{type = "changes_scan_done", args = "root", does = "a worker read a checkout's changes", who = .Internal},
	{type = "changes_diff_done", args = "tab_id", does = "a worker read a file's diff for a Changes tab", who = .Internal},
	{type = "changes_op_done", args = "tab_id, what, ok", does = "a worker staged, unstaged, discarded or committed", who = .Internal},
	{type = "reload_watch", args = "paths, scopes, version?, from_save?", does = "watched pi files changed, or pi's version on disk is known or changed (hot reload)", who = .Internal},
	{type = "reload_kick", args = "tab_id", does = "restart one idle pi tab's process on its session (hot reload)", who = .Internal},
	{type = "claude_reload_watch", args = "paths, scopes, version?, from_save?", does = "watched Claude Code files that a running Claude tab reads only at start changed, or the claude binary on disk is known or changed", who = .Internal},
	{type = "claude_reload_kick", args = "tab_id", does = "restart one idle Claude tab whose restart waited for idle (claude_restart_changed)", who = .Internal},
	{type = "markdown_open", args = "path, session?, anchor?", does = "open a Markdown file in a Markdown tab of a session (default: the current one; a relative path is from its folder), or focus the tab that has it; it shows the file as a document (preview) or its source, follows the file on disk, and anchor scrolls to a heading id (#section); created_id = tab id", who = .Anyone},
	{type = "show_file", args = "path, line? | anchor?, session?", does = "show the user a file in a tab: a Markdown file (.md, .markdown…) in a Markdown tab (rendered, follows the file on disk; anchor scrolls to a heading id, line to a source line), any other text file in an editor tab (line: 1-based); a file already open is not opened twice. A relative path is from the session's folder; any file the user could open (outside the project too: display only), never a credentials file; binary, over 20 MB, missing or a folder: refused with a hint. The session: a pi or Claude tab's own (another is refused; its tab opens right after the agent's, behind the user's view; read-only chats too), the one on screen for the user and scripts (in front), the one named for a control caller (behind). created_id = tab id; data {kind: markdown|editor, path, session, already_open}", who = .Own_Session},
	{type = "markdown_view", args = "tab_id, source", does = "show a Markdown tab's source (true) or its preview (false), at the same place", who = .Anyone},
	{type = "markdown_scroll", args = "tab_id, anchor? | line?", does = "scroll a Markdown tab's preview to a heading id or to the block at a source line (1-based)", who = .Anyone},
	{type = "markdown_link", args = "tab_id, url, confirm?", does = "follow a link of a Markdown tab's document as a click does: #heading scrolls, a relative .md file opens in a Markdown tab, another file in the editor; http, https and mailto open in the browser, and from a caller other than the user only once the user confirms (class open_link); only links the document has", who = .Anyone, confirm = .Open_Link},
	{type = "new_app_tab", args = "session?, name? | argv? | command?, cwd?, title?", does = "open an app tab in an open session (default: the one on screen): an app the session's .deckhand/apps.json declares (name), argv (argv[0] on PATH) or a command line (/bin/sh -c), in the session's folder or cwd inside it, with DECKHAND_SOCKET and a single-use app token; it shows the app's frames and gets the tab's input (docs/ENGINE-BRIDGE.md); created_id = tab id. A pi or Claude tab: its own session only, by name only, behind the user's view (not in a read-only chat)", who = .Own_Session},
	{type = "app_restart", args = "tab_id", does = "restart an app tab's program (the same argv; a hung one is killed first); a pi or Claude tab: its own session's", who = .Own_Session},
	{type = "app_close", args = "tab_id, confirm?, comments?", does = "close an app tab as close_tab does (the app gets tab.quit, then SIGTERM, SIGKILL); a pi or Claude tab: its own session's", who = .Own_Session, confirm = .Tab_Close},
	{type = "app_declared", args = "session?", does = "the apps a session's .deckhand/apps.json declares (what new_app_tab's name opens): data {session, apps [{name, argv, cwd?}]}; a pi or Claude tab: its own session's", who = .Own_Session},
	{type = "app_input", args = "tab_id, events", does = `send input to an app tab as the user's would go (events: TAB-PROTOCOL input objects, e.g. {"event":"key","action":"down","key":"w"}; sent with "source":"agent"); data.sent`, who = .Own_Session},
	{type = "app_events", args = "tab_id, topic, since?, limit?", does = "an app tab's last events of a topic (log, …; the last 500 kept): data.events [{seq, event}], data.next (pass as since)", who = .Own_Session},
	{type = "app_call", args = "tab_id, method, params?, timeout_ms?", does = `call a method of an app tab's program, answered with its reply (data, or error with data.code): the methods are the app's own, so ask it with method "tab.describe" first; params is a JSON object passed as given; tab.quit and tab.visible are Deckhand's (code reserved); timeout_ms default 10000; code tab_gone if the app exits first, timeout if it does not answer`, who = .Own_Session, long_running = true},
	{type = "app_screenshot", args = "tab_id, rect?", does = "the frame an app tab shows now (also while it is stalled, or the last one after it exited) as a PNG under the data dir: data {path, w, h, bytes, seq, tick, scale, rect, visible}; rect {x, y, w, h} crops in the tab's logical px", who = .Own_Session, long_running = true},
	{type = "app_inspect", args = "tab_id, on", does = "draw the app's boxes (its tab.boxes events) over an app tab; hovering one shows its label (the tab's Inspect button)", who = .Anyone},
	{type = "app_call_done", args = "tab_id, wire, ok, error?, data?", does = "an app answered a request", who = .Internal},
	{type = "app_update", args = "tab_id, status, exit_code?", does = "an app tab's status changed", who = .Internal},
	{type = "restore_session", args = "project_id, pi_session_id, session_dir, tabs, home?", does = "a saved session back into the state, not started", who = .Internal},
	// pending comments (comments.odin; docs/BROWSER.md §3.6–3.7)
	{type = "comment_add", args = "source, tab_id, what, text, crop", does = "a source (the browser's picker, an app's Inspect box) adds a comment for the tab's session's pi", who = .Internal},
	{type = "comment_edit", args = "comment_id, text", does = "change a pending comment's text", who = .Anyone},
	{type = "comment_delete", args = "comment_id", does = "remove a pending comment (and its crop)", who = .Anyone},
	{type = "comments_clear", args = "session", does = "remove every pending comment of an open session", who = .Anyone},
	{type = "comments_send_now", args = "session, tab_id?", does = "send an open session's pending comments (only tab_id's, if given) to its pi now, as pi_prompt with images; cleared once its bridge took them. Refused while its pi is not running, its bridge is not connected or a dialog is open", who = .Anyone, long_running = true},
	{type = "comments_ask_cancel", does = "the close prompt's Cancel: keep the tab or session and its comments", who = .User},
	// browser tabs (browser_nav.odin; docs/BROWSER.md §2): a pi tab only in and on its own session
	{type = "browser_open", args = "session?, url", does = "open a browser tab (a web page, Chromium) in a session and focus it there; created_id = tab id. The session: a pi tab's own (it may not name another), the one on screen for the user and scripts, the one named for a control caller (Atlas must name it: Home has none). url: http(s), file, about:blank, or a bare host (example.com: https://; localhost: http://); search is not built in", who = .Own_Session},
	{type = "browser_navigate", args = "tab_id, url", does = "load a URL in a browser tab (normalised as browser_open's); state: url, title, loading", who = .Own_Session},
	{type = "browser_back", args = "tab_id", does = "go back in a browser tab's history (refused when can_back is false)", who = .Own_Session},
	{type = "browser_forward", args = "tab_id", does = "go forward in a browser tab's history (refused when can_forward is false)", who = .Own_Session},
	{type = "browser_reload", args = "tab_id", does = "reload a browser tab's page (also opens a page that closed itself again)", who = .Own_Session},
	{type = "browser_stop", args = "tab_id", does = "stop loading a browser tab's page", who = .Own_Session},
	// agents read pages (browser_agent.odin; docs/BROWSER.md §4): a pi tab only its own session's tabs
	{type = "browser_tabs", args = "session?", does = "the browser tabs of a session (a pi tab: its own; a control caller: the one named, or every session's): data.tabs [{tab_id, session, title, url, loading, page, on_screen, comments, recording?}]; titles and addresses are the pages' (data)", who = .Own_Session},
	{type = "browser_read", args = "tab_id, mode?, selector?, max?", does = "read a browser tab's page (it is opened if it was unloaded, into a free slot only): mode text (default: the visible text), outline (headings, landmarks, links, controls, images and text, with refs e1… for selector \"ref=e1\") or html (the element's markup); selector: a CSS selector or ref=eN, the whole page without; max: characters (default 20000, at most 200000). Form values are never read (\"[value hidden]\"); iframes are not looked into. data {mode, url, title, text, chars, truncated, frames}: the page's content, untrusted; only the requester gets it", who = .Own_Session, long_running = true},
	{type = "browser_screenshot", args = "tab_id, rect?", does = "a PNG of the page a browser tab shows (a tab not on screen is painted for it, unseen) under the data dir's shots folder: data {path, w, h, bytes, scale, rect, on_screen}; rect {x, y, w, h} crops in the page's CSS px from the viewport's top-left", who = .Own_Session, long_running = true},
	{type = "browser_wait", args = "tab_id, for, value?, timeout_ms?", does = "wait until a browser tab's page has loaded (for load: after a navigation, its new document), shows a visible element matching a CSS selector (for selector, value) or shows a text (for text, value); timeout_ms default 10000, at most 120000; code timeout", who = .Own_Session, long_running = true},
	{type = "browser_console", args = "tab_id, since?, limit?", does = "a browser tab's console messages and exceptions after since (data.entries [{seq, level, text, source}], data.next). The first call starts recording (the Runtime and Log domains, off by default: a bot check's tell), for 5 minutes after the last call or until the page goes to another origin or the user presses Stop; earlier messages are not there (reload to see a page's load)", who = .Own_Session},
	{type = "browser_network", args = "tab_id, since?, limit?", does = "a browser tab's requests after since (data.entries [{seq, method, url, type, status, mime, failed, done}], data.next; no headers or bodies). The first call starts recording (the Network domain, off by default), as browser_console's", who = .Own_Session},
	{type = "browser_comments", args = "tab_id? | session?", does = "the pending comments of a session (only tab_id's, if given), not consumed: data.comments [{comment_id, n, source, tab_id, what, text, has_crop}]; they go to its pi with the user's next message", who = .Own_Session},
	{type = "browser_agent_stop", args = "tab_id", does = "the agent strip's Stop on a browser tab: its agents' commands and actions in flight or queued end (code stopped) and console and network recording stops; the user's", who = .User},
	// agents act on pages (browser_act.odin; docs/BROWSER.md §4, step 8): a pi tab only its own session's tabs
	{type = "browser_click", args = "tab_id, selector? | x, y, button?, double?, modifiers?", does = "click in a browser tab's page (CDP input, never the user's gesture): an outline's ref=eN or a simple selector (scrolled into view, its centre; refused when covered or disabled), or x,y in the page's CSS px; button left (default), right or middle; double; modifiers [alt, control, meta, shift]. data {action, hit {role, name, tag, ref?}, x, y, url, navigated, loading, download? (\"waiting_for_user\": a download it started asks the user), popup? (a tab opened behind), dialog?}: page data, the requester's only. Codes not_found, covered, disabled, page_not_allowed (file:, chrome:, devtools:…), user_has_control, stopped, timeout", who = .Own_Session, long_running = true},
	{type = "browser_type", args = "tab_id, text, selector?, clear?, submit?", does = "type text into a browser tab's focused field (or the field selector names, focused first): keys for ASCII, inserted text otherwise; clear: its content deleted first; submit: Enter after (never otherwise). Refused into a password, card (autocomplete cc-*), current-password, new-password or one-time-code field, or one inside such an element (code sensitive_field: the user types it after Take over), into an iframe (frame_focused); checked before every 8 keys and guarded in the page while they go (focus can move). data {action, hit, chars, submitted, url, navigated, loading}; the text is never logged (its size only)", who = .Own_Session, long_running = true},
	{type = "browser_press", args = "tab_id, keys, selector?", does = "press keys in a browser tab's page: chords separated by spaces (Enter, Tab, Shift+Tab, ArrowDown, Meta+A, a letter…; Meta+C/V/X refused: the clipboard is the user's; code bad_keys), into the focused element or selector's (focused first); the sensitive-field rule of browser_type. data {action, hit, keys, url, navigated, loading, download?}", who = .Own_Session, long_running = true},
	{type = "browser_scroll", args = "tab_id, selector? | x, y, dx?, dy?", does = "scroll a browser tab's page: the wheel (dx, dy CSS px) at the target's centre, at x,y, or at the page's centre; a selector without dx, dy is scrolled into view. data {action, hit?, scroll_x, scroll_y, moved, url}", who = .Own_Session, long_running = true},
	{type = "browser_select", args = "tab_id, selector, label? | value?", does = "choose an option of a <select> in a browser tab's page by its label or value (input and change events); refused on a card, password or one-time-code select (sensitive_field); no match: code no_option with the option labels. data {action, hit, chosen {label}, url}", who = .Own_Session, long_running = true},
	{type = "browser_hover", args = "tab_id, selector? | x, y", does = "move the pointer over an element of a browser tab's page (or x,y). data {action, hit, x, y, url}", who = .Own_Session, long_running = true},
	{type = "browser_upload", args = "tab_id, selector, paths", does = "put files (absolute paths of regular files, never a directory; at most 20) into a file input of a browser tab's page, once the user allows it: a bar on the tab says who wants to upload which files to which site, Allow / Block. Nothing is sent before Allow; unanswered in 120 s: code waiting_for_user; Block: upload_blocked; codes bad_file, not_a_file_input, page_changed. data {action, hit, files (names), url}; the paths are never logged", who = .Own_Session, long_running = true},
	{type = "browser_upload_answer", args = "tab_id, allow", does = "the upload bar's Allow or Block on a browser tab; the user's", who = .User},
	{type = "request_cancel", args = "request_id, closed", does = "a requester cancelled its long-running request (the socket's cancel line), or its connection closed: that browser action or read ends (code cancelled)", who = .Internal},
	{type = "browser_agent_take_over", args = "tab_id, on", does = "the agent strip's Take over (on) or Hand back (off) on a browser tab: while the user has control every agent call on the tab ends at once with code user_has_control (what ran or waited ends with it too); the user's own click or key in the page while an agent acts there takes over too; the user's", who = .User},
	// Claude Code tabs (claude.odin; docs/CLAUDE.md)
	{type = "new_claude_tab", args = "session? | project_id?, cwd?, resume?, args?, account?", does = "open a Claude Code tab (claude with Deckhand's plugin, in the session's folder or cwd inside its project) in an open session, or in project_id's (the session on screen if it is that project's, else its most recently shown one, else a new pi session); resume: a Claude session id (claude --resume; a tab holding it is focused, started again in place if it exited; a pi session's id or another session's key is refused); args: extra flags, the user's only; created_id = tab id. An agent's tab opens behind; account: a configured Claude Code account by label or folder (state claude_accounts; never another folder; default: the resumed entry's (no other for it), else the project's last used, else the chosen default, else the last used)", who = .Anyone},
	{type = "add_claude_account", args = "dir, label?", does = "add a Claude Code account: a config folder (CLAUDE_CONFIG_DIR) anywhere; label: its name (default: from the folder's name)", who = .User},
	{type = "rename_claude_account", args = "account, label", does = "rename a Claude Code account (account: its label or folder; \"\" = the folder's name again)", who = .User},
	{type = "set_claude_account_default", args = "account?", does = "the Claude Code account new Claude sessions start with unless their project last used another (\"\" = the environment's default)", who = .User},
	{type = "remove_claude_account", args = "account", does = "remove a Claude Code account from the list (not the default; its folder is untouched, and stays guarded while it holds Claude Code's account files)", who = .User},
	{type = "new_claude_session", args = "project_id, cwd?, args?, account?", does = "start a Claude-only session in a project: an open session whose main tab is a Claude Code tab (no pi tab), in the project's folder or cwd inside it; args: extra flags, the user's only; refused when Claude Code is not installed (state claude_installed); the Chats project_id: a Claude chat (read-only while chats are: plan mode, tools that write or run denied, a guard on Bash, the user's flags limited to --model, --effort, --fallback-model, --verbose); created_id = open session id. An agent's opens behind; account: a configured Claude Code account by label or folder (state claude_accounts; never another folder; default: the resumed entry's (no other for it), else the project's last used, else the chosen default, else the last used)", who = .Anyone},
	{type = "claude_resume", args = "claude_session_id", does = "resume a Claude Code session Deckhand ran (state claude_sessions) in a Claude-only session of its project, with its flags (the user's own resume only; anyone else's starts it without them); an open one is focused (its tab, wherever it is); created_id = its Claude tab id", who = .Anyone},
	{type = "claude_rename", args = "claude_session_id, title", does = "a Deckhand title for a Claude session of the history (its row; at most 80 characters; \"\" = none)", who = .Anyone},
	{type = "claude_prompt", args = "tab_id, text", does = "send text to a Claude tab as a user message: held until Claude is idle and the user has typed nothing since their last message (the tab shows it waiting, with Send now and Drop), then pasted and sent with Enter; at most 8 held, 64 KB each. data {held, waits}", who = .Anyone},
	{type = "claude_wait_idle", args = "tab_id, timeout_ms?", does = "wait until a Claude tab is idle: its hooks say idle, its OSC 7501 status is not working or blocked, no claude_prompt text is held and the user is not typing in it (for 300 ms); a dialog keeps it waiting. finished: ok (data.background [{kind, label}] and background_count: what Claude's last turn left running in the background; a wait never waits for it), or code timeout (the error says why it is busy), tab_gone or cancelled. Not from tabs", who = .Anyone, long_running = true},
	{type = "claude_wait_tick", does = "Claude tabs' held texts and waits while frames are paused (a timer)", who = .Internal},
	{type = "claude_held", args = "tab_id, op", does = "a Claude tab's held texts: op send (the first goes now, whatever is typed) or drop (all go); the user's", who = .User},
	{type = "claude.session", args = "tab_id?, session_id, cwd?, source?, transcript_path?, model?", does = "a Claude tab's plugin reports its Claude session id (SessionStart hook), its transcript file (kept only under Claude's config dir's projects/) and model; data {title} when the user renamed it (the hook passes it to Claude Code as sessionTitle)", who = .Claude},
	{type = "claude.readonly_ack", args = "tab_id?, nonce", does = "a read-only Claude tab's profile loaded: its SessionStart hook (Deckhand's --settings) with the start's nonce, once, before its first prompt; without it Deckhand stops the tab (docs/CLAUDE.md §1a)", who = .Claude},
	{type = "claude.turn", args = "tab_id?, state, title?, question?, idle_prompt?", does = "a Claude tab's plugin reports its turn: submitted (UserPromptSubmit; title: the prompt's first line, for the history), idle (Stop; question: its last answer ends with a question), error (StopFailure) or waiting (a permission dialog)", who = .Claude},
	{type = "claude.comments", args = "tab_id?, max?", does = "a Claude tab's plugin takes its session's pending comments for the user's message (UserPromptSubmit): data {count, attachment_id, text, images (PNG paths), more}; cleared by claude.attached", who = .Claude},
	{type = "claude.model", args = "tab_id?, model", does = "a Claude tab's plugin reports its model (PostModelSwitch): shown in its tab's tooltip and its session info", who = .Claude},
	{type = "claude.attached", args = "tab_id?, attachment_id", does = "a Claude tab's plugin: the user's message took that attachment of pending comments; they are cleared", who = .Claude},
	{type = "claude_restart", args = "tab_id, pick_model?", does = "start Claude Code again in a Claude tab whose process exited (the dead tab's Restart): with --resume <its Claude session id> when it has one; the user's saved flags only when the user restarts it; refused, with how to install it, while claude is still not found; pick_model (Restart with model…, the user's only: ignored for any other caller): Deckhand then pastes /model (Claude Code's model picker) once the new Claude is idle with bracketed paste on and nothing typed", who = .Anyone},
	{type = "claude.todos", args = "tab_id?, todos, agent_id?, seq?", does = "a Claude tab's plugin reports its todo list (TodoWrite): todos [{content, status, active_form?}] (at most 100), shown as its Todos panel; with agent_id, a subagent's own list, shown under it in the Subagents panel", who = .Claude},
	{type = "claude.task", args = "tab_id?, event, task_id, subject?, active_form?, status?, seq?", does = "a Claude tab's plugin reports one task (TaskCreated, TaskUpdate, TaskCompleted): event created, updated or completed; shown in its Todos panel", who = .Claude},
	{type = "claude.subagent", args = "tab_id?, event, agent_id?, agent_type?, description?, tool_name?, seq?", does = "a Claude tab's plugin reports a subagent: event launch (the Agent tool's call: agent_type, description), start or stop (SubagentStart, SubagentStop: agent_id, agent_type), tool (PreToolUse inside it: agent_id, tool_name, its current tool); shown as its Subagents panel", who = .Claude},
	{type = "claude.background", args = "tab_id?, event, task_id?, kind?, description?, command?, tasks?, crons?, seq?", does = "a Claude tab's plugin reports its background work: event launch (PostToolUse on a background Bash: task_id, description, command) or snapshot (Stop, SubagentStop: tasks [{id, kind, status, description?, command?}], crons [{id, schedule, recurring, prompt?}]); shown as its Background panel, and running work keeps claude_wait_idle waiting", who = .Claude},
	{type = "claude_deliver", args = "tab_id, force?", does = "a Claude tab's held text goes now", who = .Internal},
	{type = "claude_restore_history", args = "records", does = "the saved Claude sessions back into the state", who = .Internal},
	{type = "browser_update", args = "tab_id, url?, title?, loading?, can_back?, can_forward?, blocked_popup?", does = "a browser tab's page reported its address, title, loading or history, or a refused popup", who = .Internal},
	{type = "browser_popup_open", args = "opener, url, background?, pane?", does = "a page opened a popup with a user gesture: a new browser tab in the opener's session (the window's report; created_id = the tab)", who = .Internal},
	// browser tabs' polish (browser_polish.odin; docs/BROWSER.md step 3): the user's only for now
	{type = "browser_zoom", args = "tab_id, step", does = `zoom a browser tab's page: step "in", "out" or "reset" (Chrome's steps, 25%-500%; Chromium keeps it per site); state: zoom`, who = .User},
	{type = "browser_find", args = "tab_id, text, back?", does = "find text in a browser tab's page (the same text again: the next match; back: the previous); its find bar shows; state: find {text, matches, active}", who = .User},
	{type = "browser_find_close", args = "tab_id", does = "close a browser tab's find bar (the highlights go)", who = .User},
	{type = "browser_dialog", args = "tab_id, ok, text?", does = "answer the page's alert, confirm, prompt (text: the answer) or leave-page question shown in its bar (state: dialog)", who = .User},
	{type = "browser_permission", args = "tab_id, allow", does = "allow or block what the page asks in its bar (notifications, location, camera, microphone; state: permission), this once", who = .User},
	{type = "browser_popup", args = "tab_id, open", does = "the blocked-popup bar (state: blocked_popup): open the popup's address in a new tab of the same session (created_id), or (open false) close the bar", who = .User},
	{type = "browser_edit", args = "tab_id, op", does = `run an edit command in a browser tab's page: op "undo", "redo", "cut", "copy", "paste" or "select_all"`, who = .User},
	{type = "browser_devtools", args = "tab_id, x?, y?, close?", does = "open Chromium's DevTools for a browser tab in a window of its own (x, y: inspect the element at that page position, logical px), or close them; state: devtools", who = .User},
	{type = "browser_external", args = "tab_id", does = "open a browser tab's address (http or https only) in the default browser", who = .User},
	{type = "browser_download", args = "download_id, op", does = `a download a browser tab made (state: downloads): op "open" (once done), "reveal" (show in Finder; download_id 0: the downloads folder), "cancel" or "dismiss" (its bar goes)`, who = .User},
}

command_spec :: proc(type: string) -> ^Command_Spec {
	for &s in COMMAND_SPECS do if s.type == type do return &s
	return nil
}

// Whether a caller of this kind may send commands with this `who` at all
// (bridge reports also need the caller's own tab: caller_may).
who_allows :: proc(kind: Caller_Kind, who: Command_Who) -> bool {
	if kind == .Tab_Host || kind == .None do return false // TAB_HOST_COMMANDS only (caller_may); None: nobody's
	switch who {
	case .Anyone:   return kind != .Panel && kind != .App
	case .Query:    return kind != .App // an app tab's program sends no commands
	case .User:     return kind == .UI || kind == .Internal
	case .Report:   return kind != .Control && kind != .App
	case .Bridge:   return kind == .Panel
	case .Internal: return kind == .Internal
	case .Own_Session: return kind != .App
	case .User_Control: return kind == .UI || kind == .Control || kind == .Internal
	case .Claude:   return kind == .Panel || kind == .Script || kind == .Internal // caller_may: a Claude tab's own
	}
	return false
}
