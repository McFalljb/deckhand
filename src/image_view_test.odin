@(test)
image_tab_loads :: proc(t: ^testing.T) {
	context.allocator = runtime.heap_allocator()
	dir := fmt.aprintf("build/test-data/image-tab-%d", os.get_pid())
	os.remove_all(dir)
	os.make_directory_all(dir)
	defer os.remove_all(dir)
	put :: proc(dir, name, data: string) -> string {
		p := fmt.tprintf("%s/%s", dir, name)
		_ = os.write_entire_file(p, transmute([]u8)data)
		return p
	}
	ids := [?]u64{900001, 900002, 900003, 900004, 900005, 900006}
	defer for id in ids do editor_drop(id)

	e := editor_new(ids[0], put(dir, "a.png", TINY_PNG))
	testing.expect(t, e.image_tab && e.img != nil && e.readonly, "a picture")
	if e.img != nil {
		testing.expect(t, e.img.w == 2 && e.img.h == 1 && e.img.tw == 2 && len(e.img.pixels) == 8, "2 x 1 RGBA")
		testing.expect_value(t, e.img.pixels[4 + 3], u8(128)) // the second pixel's alpha
	}
	testing.expect_value(t, tb_len(&e.buf), 0) // no text: nothing for an agent to read
	testing.expect(t, strings.contains(e.refused, "PNG image, 2 × 1 px"), e.refused)

	wide := editor_new(ids[5], put(dir, "wide.png", WIDE_PNG))
	testing.expect(t, wide.img != nil && wide.img.w == 8193 && wide.img.tw == 4096 && wide.img.th == 1, "scaled down to fit a texture")
	if wide.img != nil do testing.expect_value(t, wide.img.pixels[3 * 4], u8(6)) // the fourth kept pixel is pixel 6
	huge := editor_new(ids[1], put(dir, "huge.png", HUGE_PNG))
	testing.expect(t, huge.image_tab && huge.img == nil && strings.contains(huge.refused, "megapixels"), huge.refused)
	webp := editor_new(ids[2], put(dir, "a.webp", "RIFF\x10\x00\x00\x00WEBPVP8 \x00\x00\x00\x00"))
	testing.expect(t, webp.img == nil && strings.contains(webp.refused, "WebP"), webp.refused)
	bad := editor_new(ids[3], put(dir, "bad.png", "\x89PNG\r\n\x1a\nnot really"))
	testing.expect(t, bad.img == nil && strings.has_prefix(bad.refused, "Can't display this image"), bad.refused)
	text := editor_new(ids[4], put(dir, "notes.png", "just text\n"))
	testing.expect(t, !text.image_tab && text.refused == "" && tb_len(&text.buf) == 10, "a .png that is text: a text tab")

	// changed on disk: read again (now bad bytes: it says why, the old picture gone)
	put(dir, "a.png", "\x89PNG\r\n\x1a\nbroken now, and longer")
	editor_check_disk(e)
	testing.expect(t, e.image_tab && e.img == nil && strings.has_prefix(e.refused, "Can't display"), e.refused)
	put(dir, "a.png", TINY_PNG)
	editor_check_disk(e)
	testing.expect(t, e.img != nil && e.readonly, "back")
	testing.expect_value(t, image_size_text(512), "512 B")
	testing.expect_value(t, image_size_text(3 * 1024 + 400), "3.4 KB")
}
