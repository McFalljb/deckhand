package main

// Image tabs (image_view.odin): an editor tab of a PNG holds its decoded picture, read-only and
// with no text (nothing an agent could read); a picture past the pixel cap is refused before it
// is decoded; WebP and undecodable bytes say why; a .png that is text stays a text tab; a change
// on disk reads it again; closing the tab frees it. No GPU here: the texture is made at the
// first draw.

import "base:runtime"
import "core:fmt"
import "core:os"
import "core:strings"
import "core:testing"

@(private = "file")
TINY_PNG :: "\x89\x50\x4e\x47\x0d\x0a\x1a\x0a\x00\x00\x00\x0d\x49\x48\x44\x52\x00\x00\x00\x02\x00\x00\x00\x01\x08\x06\x00\x00\x00\xf4\x22\x7f\x8a\x00\x00\x00\x0e\x49\x44\x41\x54\x78\x9c\x63\xf8\xcf\xc0\x00\x42\x0d\x00\x0f\x7a\x03\x7e\x77\xe9\x7f\x97\x00\x00\x00\x00\x49\x45\x4e\x44\xae\x42\x60\x82"
// a PNG header that says 12000 x 10000 (120 megapixels), and no pixels
@(private = "file")
HUGE_PNG :: "\x89\x50\x4e\x47\x0d\x0a\x1a\x0a\x00\x00\x00\x0d\x49\x48\x44\x52\x00\x00\x2e\xe0\x00\x00\x27\x10\x08\x06\x00\x00\x00\xd1\x4f\xd0\x3b"

// 8193 x 1, red = x & 255, and 1 x 10000, red = y & 255: past IMAGE_TEX_MAX, every second pixel
